   sim_->user_texts_new_.clear();
   sim_->user_texts_new_.emplace_back(mjFONT_NORMAL, mjGRID_TOPRIGHT, title, content);
+
+  // Never wait on a ROS callback from the physics/display producer. A missed
+  // snapshot is shown as busy instead of being misrepresented as fresh data.
+  {
+    std::unique_lock<std::mutex> lock(tcp_overlay_mutex_, std::try_to_lock);
+    if (!lock.owns_lock())
+      tcp_overlay_display_ = "SIM TCP: overlay snapshot busy";
+    else if (tcp_overlay_received_ == std::chrono::steady_clock::time_point{})
+      tcp_overlay_display_ = "SIM TCP: waiting for observer";
+    else if (std::chrono::steady_clock::now() - tcp_overlay_received_ > std::chrono::seconds(1))
+      tcp_overlay_display_ = "SIM TCP: STALE (observer missing >1s)";
+    else
+      tcp_overlay_display_ = tcp_overlay_text_;
+  }
+  sim_->user_texts_new_.emplace_back(mjFONT_NORMAL, mjGRID_TOPLEFT, tcp_overlay_display_, "");
 
