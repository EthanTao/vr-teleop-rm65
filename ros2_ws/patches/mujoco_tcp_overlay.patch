@@ -535,6 +535,29 @@ bool MujocoSimulation::initialize(rclcpp::Node::SharedPtr node, const std::string& model_path,
   mujoco_model_topic_ = mujoco_model_topic;
   sim_speed_factor_ = sim_speed_factor;
   headless_ = headless;
+
+  // RM65 viewer-only patch. Bounded ASCII text is handed to the native renderer
+  // through its existing lock-free display queue, never through a second viewer.
+  if (!headless_)
+  {
+    tcp_overlay_subscription_ = node_->create_subscription<std_msgs::msg::String>(
+        "/rm65/sim/tcp_overlay", rclcpp::QoS(1).best_effort(),
+        [this](std_msgs::msg::String::ConstSharedPtr message) {
+          const auto& value = message->data;
+          bool valid = value.size() <= 1536;
+          for (unsigned char character : value)
+          {
+            if (character != '\n' && (character < 32 || character > 126))
+            {
+              valid = false;
+              break;
+            }
+          }
+          std::lock_guard<std::mutex> lock(tcp_overlay_mutex_);
+          tcp_overlay_text_ = valid ? value : "SIM TCP: INVALID overlay text";
+          tcp_overlay_received_ = std::chrono::steady_clock::now();
+        });
+  }
 
   if (sim_speed_factor_ > 0)
   {
