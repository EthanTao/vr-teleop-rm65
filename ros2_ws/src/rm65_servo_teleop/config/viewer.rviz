Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: world
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/RobotModel
      Name: RM65
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/Pose
      Name: Servo Target
      Enabled: true
      Topic:
        Value: /rm65/target_pose
      Shape: Axes
      Axes Length: 0.08
      Axes Radius: 0.004
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.7
      Focal Point:
        X: 0.2
        Y: 0.0
        Z: 0.45
      Pitch: 0.35
      Yaw: 0.8
      Target Frame: <Fixed Frame>
Window Geometry:
  Width: 1100
  Height: 800
