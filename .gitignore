# ===== 生成物总闸 =====
# 约定：所有生成物、缓存、临时目录、历史备份都只准落在 build/（见 README「根目录纪律」）。
build/
dist/
.tmp-wheel/
*.egg-info/

# ===== Python =====
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ===== 测试产物 =====
.pytest_cache/
.pytest-tmp/
/pt-tmp/
/.pytest-*.xml
.htmlcov/
.coverage
# 兜底：沙箱里 tempfile 会退回仓库根，留下空的 tmpXXXXXXXX 目录。
# 根因已由 tests/conftest.py 改道到 build/tmp/，这里只防再次出现。
/tmp*/

# ===== 本机环境与编辑器 =====
.env
.vscode/
.idea/
.DS_Store
__MACOSX/

# ===== 仅本机使用的快照与调研数据（不进版本库）=====
# shared-dls 会读取的控制器 DH/工具帧快照，随现场标定变化
config/rm65_dls_calibration.json
# 投稿调研的来源快照与辅助脚本（约 49 MB，保留在磁盘上）
.ccf_research/
# 本机 AI 工具的工作目录与输出
.codex/
.superpowers/

# ===== 启动器产生的缓存 =====
# 正常情况下在系统临时目录；沙箱里会被 teleop.py 改道到 build/tmp/
vr-teleop-rm65.manifest.json
