root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{yaml,yml,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Unified diff context contains meaningful leading/trailing spaces.
[*.patch]
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf
